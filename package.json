{
  "name": "obsx-security",
  "version": "2.3.0",
  "description": "OBSX Security: Next-generation client integrity attestation, anti-automation, and tamper-resistant request verification.",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./core": "./lib/core.js",
    "./crypto": "./lib/crypto.js",
    "./telemetry": "./lib/telemetry.js",
    "./kv": "./lib/kv.js",
    "./config": "./lib/config.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.js",
    "update": "node -e \"require('./lib/updater').checkAndApplyUpstreamUpdate({ force: true }).then(r => console.log(JSON.stringify(r)))\"",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js",
    "pretest": "node scripts/build.js"
  },
  "keywords": [
    "security",
    "anti-tamper",
    "bot-detection",
    "integrity",
    "proof-of-work",
    "browser-verification",
    "anti-bot"
  ],
  "author": "Alexis Grimmace <alexisgrimmace@users.noreply.github.com>",
  "license": "MIT AND LicenseRef-OBSX-Zone-2-1.0",
  "files": [
    "lib/core.js",
    "lib/crypto.js",
    "lib/telemetry.js",
    "lib/kv.js",
    "lib/config.js",
    "lib/index.js",
    "index.d.ts",
    "src/tracer.js",
    "public/obsx.min.js",
    "public/tracer.min.js",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidiotspam-hue/obsx.git"
  },
  "bugs": {
    "url": "https://github.com/jidiotspam-hue/obsx/issues"
  },
  "homepage": "https://obsx.tech",
  "engines": {
    "node": ">=18.0.0"
  }
}
