# OBSX Security — Production Configuration Template
# Copy this file to .env and configure your secret credentials.
# NOTE: .env is ignored by Git and should NEVER be committed to version control.

# Server Configuration
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# Cryptographic Master Secret (Optional override; auto-generated if omitted)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBSX_SECRET=

# Custom Email Dispatcher (iCloud Mail / SMTP)
# To use your iCloud+ custom domain (e.g. obsx.tech):
# 1. Sign in to appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
# 2. Generate a new password labeled "OBSX Production"
# 3. Enter your primary Apple ID / iCloud email as SMTP_USER
# 4. Enter the generated app-specific password as SMTP_PASS
# 5. Set SMTP_FROM to your custom domain address (e.g. security@obsx.tech or noreply@obsx.tech)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OBSX Security <noreply@obsx.tech>"

# Optional State Persistence
# Set to true to automatically persist in-memory nonces across server updates & daemon restarts
OBSX_PERSIST_KV=true

# Optional External Redis / Upstash Cache URL
# Leave empty to use in-memory fast storage
# REDIS_URL=
