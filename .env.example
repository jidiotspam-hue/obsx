# OBSX Security — Production Configuration Template
# Copy this file to .env and configure your secret credentials.
# NOTE: .env is ignored by Git and should NEVER be committed to version control.

# Server Configuration
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# Cryptographic Master Secret (Optional for session signing; REQUIRED >= 16 chars to enable x-obsx-key operator APIs)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBSX_SECRET=

# Operator Dashboard Allowlist (Required for email-authenticated sessions on /api/v1/alerts and /api/v1/system/*)
# Comma-separated email addresses permitted to access operator/system endpoints alongside x-obsx-key.
# OPERATOR_EMAILS=admin@example.com
# OPERATOR_EMAIL=
# OBSX_OPERATOR_EMAILS=

# Custom Email Dispatcher (iCloud Mail / SMTP)
# To use your iCloud+ custom domain (e.g. obsx.tech):
# 1. Sign in to appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
# 2. Generate a new password labeled "OBSX Production"
# 3. Enter your primary Apple ID / iCloud email as SMTP_USER
# 4. Enter the generated app-specific password as SMTP_PASS
# 5. Set SMTP_FROM to your custom domain address (e.g. security@obsx.tech or noreply@obsx.tech)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OBSX Security <noreply@obsx.tech>"

# Optional State Persistence
# Set to true to automatically persist in-memory nonces across server updates & daemon restarts
OBSX_PERSIST_KV=true

# Optional External Redis / Upstash Cache URL
# Leave empty to use in-memory fast storage
# REDIS_URL=

# --- Bot Protection (origin shield) ---
# Tiered L7 flood control: engagement thresholds are in requests per second.
OBSX_BOT_PROTECTION=true          # false disables the shield entirely
OBSX_BOT_MODE=auto                # auto | always | off
OBSX_SHIELD_RPS=120               # engage when the origin sees this many req/s
OBSX_SHIELD_OFF_RPS=40            # stand down once traffic falls below this
OBSX_SHIELD_CALM_MS=45000         # how long it must stay calm before standing down
OBSX_BOT_DIFFICULTY=16            # base proof-of-work difficulty (leading zero bits)
OBSX_BOT_MAX_DIFFICULTY=22        # ceiling the adaptive ramp will reach
OBSX_BOT_TTL=900000               # minutes of free passage after a solved challenge
OBSX_BOT_MAX_ATTEMPTS=6           # unsolved challenges before quarantine
OBSX_BOT_CHALLENGE_TTL=120000       # how long an unsolved challenge stays valid (ms)
OBSX_BOT_QUARANTINE_MS=300000     # base quarantine length (escalates per strike)
OBSX_IP_BUDGET=60                 # unverified requests per minute per IP
OBSX_VERIFIED_BUDGET=600          # requests per minute for a verified client
OBSX_CALM_BUDGET=400              # per-IP budget while the shield is not engaged
OBSX_STATUS_BUDGET=40             # health/status requests per minute per IP
OBSX_SUBNET_BUDGET=900            # requests per minute per /24 or /64
OBSX_SUBNET_QUARANTINE=2400       # subnet request rate that quarantines the range
OBSX_UA_FLEET_BUDGET=1500         # requests per minute per user-agent class
OBSX_CRAWLER_BUDGET=240           # requests per minute for search engines
OBSX_HARD_CONN_CEILING=600        # refuse new sockets above this many connections
OBSX_MAX_CONNS_PER_IP=120         # sockets one address may hold at once
OBSX_MAX_CONCURRENT_PER_IP=25       # in-flight requests one address may hold
OBSX_FANOUT_IPS=400                 # distinct addresses/min that reads as a botnet
OBSX_FANOUT_SUBNETS=120             # distinct /24s per minute: a fleet that rotates ranges
OBSX_MAX_PATH_LEN=256               # path-fuzz floods are refused before any work is done
OBSX_FANOUT_PATHS=800               # distinct paths/min that reads as a path-fuzz flood
OBSX_BOT_MAX_SOLVE_MS=3000          # if real browsers report slower than this, ease the puzzle back
OBSX_QUARANTINE_ESCAPE=1            # 1 = a quarantined address with browser evidence may solve out of it
OBSX_QUARANTINE_ESCAPE_ATTEMPTS=12  # how many escape puzzles that is allowed, then it is refused
OBSX_MAX_CONNS=300                # shed when keep-alive connections exceed this
OBSX_MAX_INFLIGHT=100             # shed when requests in flight exceed this
OBSX_MAX_SERVED_RPS=150           # served-request ceiling before shedding starts
OBSX_MAX_WORK_LATENCY=250         # shed when average request work exceeds this (ms)
OBSX_MAX_RSS_MB=620               # shed before the process runs out of memory
OBSX_MAX_EVENT_LAG_MS=200           # shed when the event loop is falling behind
OBSX_SHIELD_MAP_SIZE=20000        # hard cap on every internal map
OBSX_MAX_BODY_BYTES=524288          # request bodies above this are refused before parsing
OBSX_CHECK_FORWARDED=true           # refuse clients whose x-forwarded-for chain contradicts cf-connecting-ip
